# HeteroForge 忽略规则。
# 临时文件一律根锚定 "/_xxx", 避免误伤同名业务目录; 包目录白名单用 "/**/__init__.py" 负向规则保护。

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 临时与中间产物, 根锚定, 只匹配仓库根的临时目录
/_tmp/
/_scratch/
/_smoke/
/_verify/
/_build/
/_dist/

# 运行产物与实验数据
runs/
artifacts/
reports/
*.log

# pytest --basetemp 落点与数据缓存; data/ 下的 smoke 产物需要入库, 因此只忽略子目录
/data/.pytest-tmp/
/data/cache/

# 打包与分发
build/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/

# 编辑器与系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 覆盖率
.coverage
.coverage.*
htmlcov/

# 反向规则: 绝不忽略任何层级的 __init__.py, 否则干净克隆会因缺包初始化而崩溃
!/**/__init__.py
